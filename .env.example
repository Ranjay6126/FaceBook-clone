# ===== Root-level environment variables (Vercel production) =====
# Copy this to Vercel Dashboard -> Project -> Settings -> Environment Variables
# Use these variables in BOTH Production and Preview environments.

# ---- MongoDB Atlas ----
# Option A: Full connection string (preferred for Vercel)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.ip4otym.mongodb.net/facebook-clone?retryWrites=true&w=majority&appName=Cluster0

# Option B: Individual parts (if MONGO_URL is not set, these are combined automatically)
MONGO_USER=devipanditmanju2_db_user
MONGO_PASSWORD=BXSM1Q3F8TnNJv4i
MONGO_HOST=cluster0.ip4otym.mongodb.net
MONGO_DB_NAME=facebook-clone

# ---- Authentication ----
# MUST be a long random string in production (>= 32 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-please-32chars-minimum

# ---- Node environment ----
NODE_ENV=production
